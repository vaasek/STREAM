<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Streamon" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:editTextColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="colorPrimary">@color/mint</item>
        <item name="colorOnPrimary">@color/mint_ink</item>
        <item name="colorSurface">@color/bg_2</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Streamon.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bg</item>
        <item name="boxStrokeColor">@color/stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <style name="Streamon.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">@color/mint</item>
        <item name="android:textColor">@color/mint_ink</item>
    </style>

    <style name="Streamon.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/ink</item>
        <item name="backgroundTint">@color/bg_2</item>
    </style>

    <style name="Streamon.Button.Quiet" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:minHeight">44dp</item>
    </style>
</resources>
