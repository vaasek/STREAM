[Unit]
Description=Streamon video conferences and live streams
After=network.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
EnvironmentFile=__ROOT__/.env
ExecStart=__NODE__ server/src/index.js
Restart=on-failure
RestartSec=3
User=__USER__
Group=__GROUP__
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
