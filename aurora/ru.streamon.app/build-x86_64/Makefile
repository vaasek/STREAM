####### Compile

main.o: ../src/main.cpp ../src/session.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../src/main.cpp

session.o: ../src/session.cpp ../src/session.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o session.o ../src/session.cpp

moc_session.o: moc_session.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_session.o moc_session.cpp

####### Install

install_qml: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/ru.streamon.app || mkdir -p $(INSTALL_ROOT)/usr/share/ru.streamon.app
	-$(INSTALL_DIR) /workspace/aurora/ru.streamon.app/qml $(INSTALL_ROOT)/usr/share/ru.streamon.app/

uninstall_qml: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/ru.streamon.app/qml
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/ru.streamon.app/ 


install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/bin || mkdir -p $(INSTALL_ROOT)/usr/bin
	-$(INSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/bin/ 


install_desktop: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/applications || mkdir -p $(INSTALL_ROOT)/usr/share/applications
	-$(INSTALL_PROGRAM) /workspace/aurora/ru.streamon.app/ru.streamon.app.desktop $(INSTALL_ROOT)/usr/share/applications/
	-: $(INSTALL_ROOT)/usr/share/applications/ru.streamon.app.desktop

uninstall_desktop: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/applications/ru.streamon.app.desktop
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/applications/ 


