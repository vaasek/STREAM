# Порт HTTP/HTTPS API и веб-клиента
PORT=8080
HOST=0.0.0.0

# IP, который клиенты подставляют в WebRTC.
# Для сервера в сети укажите его LAN или публичный IP. Пусто = 127.0.0.1 (только этот компьютер).
ANNOUNCED_IP=192.168.1.1

# Диапазон UDP/TCP для медиа. Откройте его в firewall.
RTC_MIN_PORT=40000
RTC_MAX_PORT=40199

# Секрет сессий. Пусто — создаётся один раз в data/jwt.secret
JWT_SECRET=

# Первый администратор, если база ещё пустая
ADMIN_EMAIL=admin@streamon.local
ADMIN_PASSWORD=464f6w34545fw634f

# Каталог базы и секретов. Пусто — ./data
DATA_DIR=

# HTTPS для камеры и микрофона в браузере. Порт 8080 остаётся обычным HTTP для приложения.
# Пустые TLS_CERT и TLS_KEY — сервер сам создаёт сертификат для ANNOUNCED_IP.
HTTPS_PORT=8443
TLS_CERT=
TLS_KEY=

# Уровень логов mediasoup: error | warn | debug
MEDIASOUP_LOG=warn
